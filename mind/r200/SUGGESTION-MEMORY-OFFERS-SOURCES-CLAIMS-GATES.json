  "claims": [
    {
      "id": "wording_speed",
      "statement": "Post-event wording changed accident-speed judgments",
      "source_ids": [
        "loftus1974"
      ],
      "decision": "SUPPORT_SPECIFIC",
      "limits": "Controlled auto-film questions, not general misinformation prevalence"
    },
    {
      "id": "broken_glass",
      "statement": "Participants later reported broken glass absent from film after verb manipulation",
      "source_ids": [
        "loftus1974"
      ],
      "decision": "SUPPORT_SPECIFIC",
      "limits": "Report at follow-up, not proof of vivid internal sensory experience"
    },
    {
      "id": "drm40_55",
      "statement": "False critical-item recall reported 40% in one task and 55% in another",
      "source_ids": [
        "roediger1995"
      ],
      "decision": "SUPPORT_SPECIFIC",
      "limits": "Study procedure rates, not people or recovered memories"
    },
    {
      "id": "hypnotic_memory",
      "statement": "Hypnotically refreshed memories may be unreliable",
      "source_ids": [
        "ama1985",
        "kihlstrom1997"
      ],
      "decision": "SUPPORT_SCOPED",
      "limits": "Mainly memory enhancement forensic context, not all hypnosis outcomes"
    },
    {
      "id": "confidence_vs_truth",
      "statement": "Confidence in recall can increase without proportionate accuracy",
      "source_ids": [
        "krass1989",
        "kihlstrom1997"
      ],
      "decision": "SUPPORT_SCOPED",
      "limits": "Not every confident report false"
    },
    {
      "id": "memory_review_rates",
      "statement": "2021 false-memory lab induction review found heterogeneous outcomes",
      "source_ids": [
        "falsemem2021"
      ],
      "decision": "SUPPORT_SCOPED",
      "limits": "DO NOT quote as consumer audio incidence"
    },
    {
      "id": "puysegur",
      "statement": "Puységur source files trace somnambulism history",
      "source_ids": [
        "puysegur_live"
      ],
      "decision": "HISTORICAL_CONTEXT",
      "limits": "Not therapeutic proof"
    },
    {
      "id": "theory_debate",
      "statement": "Competing mechanisms of hypnosis remain under debate",
      "source_ids": [
        "zahedi2024"
      ],
      "decision": "SUPPORT_REVIEW",
      "limits": "Do not treat hypnosis as categorically ineffective"
    },
    {
      "id": "maclean_retreat_1",
      "statement": "Retreat 1 trained n=30 vs wait list n=30; target length was recalibrated",
      "source_ids": [
        "maclean2010"
      ],
      "decision": "SUPPORT_WITH_LIMIT",
      "limits": "No observed vigilance reduction in Retreat 1; discrimination improved"
    },
    {
      "id": "maclean_retreat_2",
      "statement": "Retreat 2 fixed target and saw vigilance improvement among later-trained n=27 completers",
      "source_ids": [
        "maclean2010"
      ],
      "decision": "SUPPORT_WITH_LIMIT",
      "limits": "Not product-specific; perceptual demand may explain"
    },
    {
      "id": "mrazek_intervention",
      "statement": "48 undergrads compared 2wk mindfulness course vs nutrition course",
      "source_ids": [
        "mrazek2013"
      ],
      "decision": "SUPPORT_PRIMARY",
      "limits": "Eight 45-minute classes plus daily practice; not MP3"
    },
    {
      "id": "mrazek_mediation",
      "statement": "Mind wandering mediated gains in higher-baseline-wandering subgroup",
