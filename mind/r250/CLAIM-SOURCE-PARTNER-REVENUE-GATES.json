  "claims": [
    {
      "id": "C01",
      "source": "MEM74",
      "classification": "EXPERIMENTAL_OBSERVATION",
      "statement": "Post-event verb changes influenced speed estimates in a 1974 accident-film task",
      "policy": "CAN_REPORT_WITH_DESIGN_CAVEAT"
    },
    {
      "id": "C02",
      "source": "MEM74",
      "classification": "EXPERIMENTAL_OBSERVATION",
      "statement": "A delayed broken-glass question produced more affirmative reports in the forceful-verb condition although footage had no glass",
      "policy": "CAN_REPORT_WITH_DESIGN_CAVEAT"
    },
    {
      "id": "C03",
      "source": "MEM78",
      "classification": "PRIMARY_ABSTRACT",
      "statement": "A total of 1242 participants in five experiments and a pilot encountered consistent, irrelevant or misleading postevent descriptions",
      "policy": "CAN_REPORT_WITH_TOTAL_SAMPLE_CAVEAT"
    },
    {
      "id": "C04",
      "source": "MEM78",
      "classification": "PRIMARY_ABSTRACT",
      "statement": "Misleading postevent descriptions reduced recognition accuracy on yes-no and forced-choice tests",
      "policy": "CAN_REPORT"
    },
    {
      "id": "C05",
      "source": "MEM23",
      "classification": "PRIMARY_STUDY",
      "statement": "Repeating misinformation increased suggestibility in experimental conditions; apparent source variability did not add effect under those tested comparisons",
      "policy": "CAN_REPORT_BOUND_TO_STUDY"
    },
    {
      "id": "C06",
      "source": "MEM23",
      "classification": "META_ANALYTIC",
      "statement": "This paper reports a repetition meta-analysis k=19 and source variability meta-analysis k=8; do not imply independent participants are same in both",
      "policy": "CAN_REPORT"
    },
    {
      "id": "C07",
      "source": "COR19",
      "classification": "META_ANALYTIC_ABSTRACT",
      "statement": "Continued-influence correction meta-analysis includes 32 studies and 6527 participants; not a false eyewitness-memory rate",
      "policy": "CAN_REPORT_WITH_CONSTRUCT_DISTINCTION"
    },
    {
      "id": "C08",
