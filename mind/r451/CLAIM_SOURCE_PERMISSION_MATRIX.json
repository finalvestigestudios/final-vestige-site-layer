  "claims": [
    {
      "id": "M01",
      "claim": "1976 audiovisual /ba/+/ga/ mismatch could produce perceived /da/",
      "source": "mcgurk76",
      "verdict": "SUPPORTED_EXPERIMENT",
      "boundary": "Speech perception; not a meditation or hypnosis result"
    },
    {
      "id": "M02",
      "claim": "1976 study found a specific effect in all humans",
      "source": "mallick15",
      "verdict": "REJECT",
      "boundary": "Later evidence finds large participant and stimulus variation"
    },
    {
      "id": "M03",
      "claim": "2015 first experiment involved 165 English-speaking adults and 12 stimuli",
      "source": "mallick15",
      "verdict": "SUPPORTED_EXPERIMENT"
    },
    {
      "id": "M04",
      "claim": "2015 stimulus response frequency varied 17% to 58%",
      "source": "mallick15",
      "verdict": "SUPPORTED_EXPERIMENT"
    },
    {
      "id": "M05",
      "claim": "2015 participant response frequency varied 0% to 100%",
      "source": "mallick15",
      "verdict": "SUPPORTED_EXPERIMENT"
    },
    {
      "id": "M06",
      "claim": "2015 forced-choice question raised observed effect by estimated 18 percentage points",
      "source": "mallick15",
      "verdict": "SUPPORTED_EXPERIMENT",
      "boundary": "Question format effect, not brain change"
    },
    {
      "id": "M07",
      "claim": "2015 one-year retest of 40 correlated 0.91",
      "source": "mallick15",
      "verdict": "SUPPORTED_EXPERIMENT",
      "boundary": "Subsample, not general lifespan prediction"
    },
    {
      "id": "M08",
      "claim": "Eye fixation time associated with effect frequency in study of 40",
