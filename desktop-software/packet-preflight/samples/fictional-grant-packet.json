{
  "title": "FICTIONAL application package — not official agency guidance",
  "forbid_unmatched": true,
  "max_total_size_mb": 25,
  "rules": [
    {
      "name": "Application form",
      "pattern": "application*.pdf",
      "minimum": 1,
      "maximum": 1,
      "max_size_mb": 10,
      "extensions": [
        ".pdf"
      ]
    },
    {
      "name": "Budget workbook",
      "pattern": "budget*.xlsx",
      "minimum": 1,
      "maximum": 1,
      "max_size_mb": 5,
      "extensions": [
        ".xlsx"
      ]
    },
    {
      "name": "Narrative",
      "pattern": "narrative*.pdf",
      "minimum": 1,
      "maximum": 1,
      "max_size_mb": 8,
      "extensions": [
        ".pdf"
      ]
    },
    {
      "name": "Supporting attachments",
      "pattern": "supporting/**",
      "minimum": 0,
      "max_size_mb": 10
    }
  ]
}
