{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/",
  "login": true,
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_ENVIRONMENT_TYPE": "local",
        "FV_EX2_ALLOW_PREVIEW": true,
        "WP_DEBUG": true
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "assembler"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/uploads/fv-ex2-parity/apply_local_parity.php';"
    }
  ]
}
