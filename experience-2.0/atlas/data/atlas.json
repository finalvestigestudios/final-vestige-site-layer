  "claims": [
    {
      "id": "clm-record-01-1",
      "investigation_id": "inv-434",
      "text": "The January 27, 1967 Plugs-Out Test was run with the launch vehicle unfueled.",
      "status": "verified",
      "source_ids": [
        "src-nasa-history-aftermath",
        "src-nasa-board-report"
      ],
      "caveat": "NASA History (2022): \"Because the test took place with the rocket unfueled, it had been considered non-hazardous\". Board report, Part IV: the Plugs-Out Test was not classified as hazardous because only tests involving fueled vehicles were."
    },
    {
      "id": "clm-record-01-2",
      "investigation_id": "inv-434",
      "text": "The innermost hatch took 90 seconds to open under ideal conditions.",
      "status": "verified",
      "source_ids": [
        "src-nasa-history-aftermath"
      ],
      "caveat": "NASA History (2022): the innermost hatch opened inward \"and taking 90 seconds to open under ideal conditions\"."
    },
    {
      "id": "clm-record-02-1",
      "investigation_id": "inv-434",
      "text": "The test used a 16.7 psia, 100 percent oxygen atmosphere.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 2: \"The test was conducted with a 16.7 pounds per square inch absolute, 100-percent oxygen atmosphere.\""
    },
    {
      "id": "clm-record-02-2",
      "investigation_id": "inv-434",
      "text": "The test conditions were extremely hazardous.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 2, Determination: \"The test conditions were extremely hazardous.\""
    },
    {
      "id": "clm-record-02-3",
      "investigation_id": "inv-434",
      "text": "The atmosphere presents severe fire hazards if combustibles are not restricted and controlled.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 9, Determination: \"This atmosphere presents severe fire hazards if the amount and location of combustibles in the Command Module are not restricted and controlled.\""
    },
    {
      "id": "clm-record-03-1",
      "investigation_id": "inv-434",
      "text": "The first verbal fire report began at 23:31:04.7 GMT.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation"
      ],
      "caveat": "Board report, Part V: \"This transmission began at 23:31:04.7 GMT with an exclamatory remark.\""
    },
    {
      "id": "clm-record-03-2",
      "investigation_id": "inv-434",
      "text": "The first pressure increase was recorded about 6 seconds after the report.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation"
      ],
      "caveat": "Board report, Part V, Cabin Pressure Rise: \"about 6 seconds after the crew first reported the fire\". The NASA web text prints the clock time as 23:21:11, an apparent typographical error for 23:31:11; the interval is unaffected."
    },
    {
      "id": "clm-record-03-3",
      "investigation_id": "inv-434",
      "text": "Pressure exceeded the transducer range (17 psia cabin) by 23:31:16 GMT.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation"
      ],
      "caveat": "Board report, Part V, Cabin Pressure Rise."
    },
    {
      "id": "clm-record-03-4",
      "investigation_id": "inv-434",
      "text": "The cabin ruptured at about 23:31:19 GMT at a pressure of at least 29 psia.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation"
      ],
      "caveat": "Board report, Part V: \"The cabin ruptured at a time of about 23:31:19 GMT and at a pressure of at least 29 psia.\""
    },
    {
      "id": "clm-record-03-5",
      "investigation_id": "inv-434",
      "text": "The first stage of the fire ended approximately 15 seconds after the verbal report.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation"
      ],
      "caveat": "Board report, Part V, Chronology of the Fire: the first stage \"terminated approximately 15 seconds after the verbal report of fire\". The interval between the 04.7 and 19.4 time marks is 14.7 seconds; this page uses the Board's wording, \"about fifteen\"."
    },
    {
      "id": "clm-record-04-1",
      "investigation_id": "inv-434",
      "text": "The innermost hatch opened inward.",
      "status": "verified",
      "source_ids": [
        "src-nasa-history-aftermath"
      ],
      "caveat": "NASA History (2022): \"with the innermost one opening inward and taking 90 seconds to open under ideal conditions\"."
    },
    {
      "id": "clm-record-04-2",
      "investigation_id": "inv-434",
      "text": "Due to internal pressure the inner hatch could not be opened before rupture.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 4: \"Due to internal pressure, the Command Module inner hatch could not be opened prior to rupture of the Command Module.\""
    },
    {
      "id": "clm-record-04-3",
      "investigation_id": "inv-434",
      "text": "Ed White, as Senior Pilot, was responsible for opening the hatch in an emergency.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation",
        "src-nasa-apollo1-crew-bios"
      ],
      "caveat": "Board report, Part V: \"Emergency procedures called for the Senior Pilot, occupying the center couch, to unlatch and remove the hatch\". NASA crew biographies: \"Ed White was selected as Senior Pilot for the first Apollo flight.\""
    },
    {
      "id": "clm-record-04-4",
      "investigation_id": "inv-434",
      "text": "The Senior Pilot's harness buckle was found unopened, indicating that he had begun the standard hatch-opening procedure.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-investigation"
      ],
      "caveat": "Board report, Part V: \"The Senior Pilot's harness buckle was found unopened after the fire indicating that he initiated the standard hatch opening procedure.\""
    },
    {
      "id": "clm-record-05-1",
      "investigation_id": "inv-434",
      "text": "The Board determined that the most probable initiator was an electrical arc in the sector between the -Y and +Z spacecraft axes.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 1, Determination: \"The most probable initiator was an electrical arc in the sector between -Y and +Z spacecraft axes.\""
    },
    {
      "id": "clm-record-05-2",
      "investigation_id": "inv-434",
      "text": "No single ignition source of the fire was conclusively identified.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 1: \"No single ignition source of the fire was conclusively identified.\""
    },
    {
      "id": "clm-record-05-3",
      "investigation_id": "inv-434",
      "text": "The crew was never capable of effecting emergency egress.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-findings"
      ],
      "caveat": "Board report, Finding 4, Determination: \"The crew was never capable of effecting emergency egress because of the pressurization before rupture and their loss of consciousness soon after rupture.\""
    },
    {
      "id": "clm-record-06-1",
      "investigation_id": "inv-434",
      "text": "NASA replaced the inward-opening hatch with a unified hatch that opened outward and could be opened from inside or outside in three seconds.",
      "status": "verified",
      "source_ids": [
        "src-nasa-history-aftermath"
      ],
      "caveat": "NASA History (2022): \"a unified hatch that could be opened from inside or outside the spacecraft in three seconds\"; the astronauts cited \"the new outward-opening unified hatch\". Exhibit text photographed at Kennedy Space Center gives 5 seconds for the Block II hatch; this page uses NASA's article."
    },
    {
      "id": "clm-record-06-2",
      "investigation_id": "inv-434",
      "text": "102 deliberate ignitions of Boilerplate 1224 between December 1967 and February 1968.",
      "status": "verified",
      "source_ids": [
