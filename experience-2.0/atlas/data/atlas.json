  "claims": [
    {
      "id": "clm-record-01-1",
      "investigation_id": "inv-434",
      "text": "The test was a plugs-out countdown rehearsal with an unfueled Saturn IB.",
      "status": "article-only",
      "source_ids": [
        "src-wp-434"
      ],
      "caveat": "Final Vestige article; not re-checked against the Board text in Sprint 5."
    },
    {
      "id": "clm-record-02-1",
      "investigation_id": "inv-434",
      "text": "The test used a 16.7 psia, 100 percent oxygen atmosphere.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-report"
      ],
      "caveat": "Board report: 'The test was conducted with a 16.7 pounds per square inch absolute, 100-percent oxygen atmosphere.'"
    },
    {
      "id": "clm-record-02-2",
      "investigation_id": "inv-434",
      "text": "The test conditions were extremely hazardous.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-report"
      ],
      "caveat": "Board determination under Finding 2."
    },
    {
      "id": "clm-record-03-1",
      "investigation_id": "inv-434",
      "text": "The first verbal fire report began at 23:31:04.7 GMT.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-report"
      ],
      "caveat": "Board report, chronology: 'the transmission reporting the fire which began at 23:31:04.7 GMT (6:31:04.7 p.m. EST)'."
    },
    {
      "id": "clm-record-03-2",
      "investigation_id": "inv-434",
      "text": "The first pressure increase was recorded about 6 seconds after the report.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-report"
      ],
      "caveat": "Board report, Cabin Pressure Rise: 'about 6 seconds after the crew first reported the fire'. The NASA web text prints the clock time as 23:21:11, an apparent typographical error for 23:31:11; the interval is unaffected."
    },
    {
      "id": "clm-record-03-3",
      "investigation_id": "inv-434",
      "text": "Pressure exceeded the transducer range (17 psia cabin) by 23:31:16 GMT.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-report"
      ],
      "caveat": "Board report, Cabin Pressure Rise."
    },
    {
      "id": "clm-record-03-4",
      "investigation_id": "inv-434",
      "text": "The cabin ruptured at about 23:31:19 GMT at a pressure of at least 29 psia.",
      "status": "verified",
      "source_ids": [
        "src-nasa-board-report"
      ],
      "caveat": "Board report: 'ruptured at a time of about 23:31:19 GMT and at a pressure of at least 29 psia'; another passage gives 23:31:19.4."
    },
    {
      "id": "clm-record-03-5",
      "investigation_id": "inv-434",
      "text": "Chapter title says fourteen seconds.",
      "status": "editorial-note",
      "source_ids": [
